<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="30dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="117dp"
        android:background="@drawable/fondo_azul"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPerfilBusqueda"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/fondo_perfil"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@drawable/caja_redonda" />

        <TextView
            android:id="@+id/tvNombreBusqueda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Nombre"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/ivPerfilBusqueda"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTiempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="1d"
            android:textColor="#FF5252"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvNombreBusqueda"
            app:layout_constraintStart_toEndOf="@id/tvNombreBusqueda"
            app:layout_constraintTop_toTopOf="@id/tvNombreBusqueda" />

        <TextView
            android:id="@+id/tvDescripcionViaje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Descripción del viaje..."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/llChatContainer"
            app:layout_constraintStart_toStartOf="@id/tvNombreBusqueda"
            app:layout_constraintTop_toBottomOf="@id/tvNombreBusqueda" />

        <TextView
            android:id="@+id/tvHoraSalida"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Distancia sobre ti: "
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/llChatContainer"
            app:layout_constraintStart_toStartOf="@id/tvNombreBusqueda"
            app:layout_constraintTop_toBottomOf="@id/tvDescripcionViaje" />

        <TextView
            android:id="@+id/tvHoraSalida2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Salida a las 00:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/llChatContainer"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/tvNombreBusqueda"
            app:layout_constraintTop_toBottomOf="@id/tvDescripcionViaje" />

        <LinearLayout
            android:id="@+id/llChatContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivIconoChat"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/icon_chat"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviar mensaje"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>