<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Foto del usuario -->
    <ImageView
        android:id="@+id/imgUsuario"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_usuario_placeholder"
        android:scaleType="centerCrop"
        android:layout_gravity="center_vertical"
        android:background="@drawable/caja_redonda" />

    <!-- Contenedor de textos -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:gravity="center_vertical">

        <!-- Fila superior: nombre y tiempo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Nombre del usuario -->
            <TextView
                android:id="@+id/tvUsuario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nombre Usuario"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- Tiempo del último mensaje -->
            <TextView
                android:id="@+id/tvTiempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1d"
                android:textColor="@color/red_light"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Fila inferior: último mensaje y puntito rojo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Último mensaje -->
            <TextView
                android:id="@+id/tvMensajeUltimo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Último mensaje"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Puntito rojo de mensaje no leído -->
            <View
                android:id="@+id/viewNoLeido"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circulo_rojo"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>