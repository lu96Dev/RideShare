<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/fondo_azul">

    <!-- Título -->
    <TextView
        android:id="@+id/InfoTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Publicar nuevo viaje"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ESTE ES EL BOTÓN QUE ABRIRÁ EL MAPA -->
    <TextView
        android:id="@+id/tvDireccion"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/caja_redonda"
        android:text="Toca para abrir el mapa"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/InfoTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- HORA -->
    <EditText
        android:id="@+id/hora"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/caja_redonda"
        android:hint="Hora de salida (ej: 08:00)"
        android:textColor="@color/black"
        android:paddingStart="16dp"
        android:focusable="false"
        android:clickable="true"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvDireccion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- COMENTARIO -->
    <EditText
        android:id="@+id/comentario"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/caja_redonda"
        android:hint="Comentario (Opcional)..."
        android:textColor="@color/black"
        android:paddingStart="16dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/hora"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTÓN -->
    <Button
        android:id="@+id/btnContinuar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/boton_gradiante"
        android:text="Publicar Viaje"
        android:textColor="@android:color/white"
        android:textSize="16dp"
        app:backgroundTint="@null"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/comentario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>