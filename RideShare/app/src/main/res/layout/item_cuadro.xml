<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/caja_azul"
    android:padding="16dp">

    <!-- Foto del usuario a la izquierda -->
    <ImageView
        android:id="@+id/fotoUsuario"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="28dp"
        android:background="@drawable/caja_redonda"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_user_placeholder"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.343" />

    <!-- Contenedor vertical para las 3 líneas de texto -->
    <LinearLayout
        android:id="@+id/lineas_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/fotoUsuario"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Nombre (negrita) -->
        <TextView
            android:id="@+id/textViewNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <!-- Disponibilidad -->
        <TextView
            android:id="@+id/textViewDisponibilidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disponibilidad"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>

        <!-- Hora de salida -->
        <TextView
            android:id="@+id/textViewHoraSalida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hora de salida"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
    <!-- para el icono del mensaje -->
    <LinearLayout
        android:id="@+id/btnMensaje"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/iconoMensaje"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon_chat"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enviar mensaje"
            android:textSize="10dp"
            android:textColor="@android:color/white"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>